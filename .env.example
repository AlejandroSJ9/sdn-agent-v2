# Copiar a .env y completar. Nunca subir .env al repositorio.
AGENT_TOKEN=
OPERADOR_TOKEN=
RYU_URL=http://localhost:8080
OPENROUTER_API_KEY=
# Obligatorio: el modelo de OpenRouter que usa TODO el proyecto (no hay valor por defecto en el código)
LLM_MODELO=deepseek/deepseek-v4.1-flash
# v4 genera más texto; con 20-40 s hubo respaldos por timeout
LLM_TIMEOUT=60
LLM_HABILITADO=true
LLM_CUPO_DIARIO=1000
# URL /exec de tu implementación de Apps Script; no la subas al repo
APPSCRIPT_URL=
APPSCRIPT_TIMEOUT=30
PANEL_URL=http://localhost:8081
DEDUP_SEGUNDOS=60
# Contexto dinámico (C6): historial del host y actividad reciente de la red en el prompt
CONTEXTO_HABILITADO=false
HISTORIAL_DIAS=30
CAMPANA_MINUTOS=30
# Prompt v4.0 / v4.1 con explicación simple (aprobado en la Fase D3.1). false vuelve a v3.0 / v3.1, por ejemplo
# para repetir la comparación v3 contra v4 en el laboratorio.
PROMPT_V4=true
# Motor de políticas (C7): solo_explicar | recomendar. El agente solo recomienda; el operador aprueba.
# autonomo_acotado se retiró en la Fase D1 (si aparece, el agente arranca en recomendar).
# UMBRAL_CONFIANZA, MAX_ACCIONES_POR_MIN y HOSTS_PROTEGIDOS están retiradas: se ignoran.
MODO_DECISION=recomendar
# Escalera de respuesta (C7, Fase 9a): 0.50 ≤ ESCALON_HITL < ESCALON_VLAN ≤ 1
ESCALON_HITL=0.70
ESCALON_VLAN=0.95
# A7: límite de limitar_tasa en kbps (solo .env)
LIMITE_TASA_KBPS=1000
RECOMENDACION_TTL_MIN=60
RATE_LIMIT_POR_MIN=60
ALERTA_MAX_BYTES=65536
DB_URL=sqlite:///./sdn_agent.db
# Clave secreta del HMAC de la auditoría (cadena larga y aleatoria). Si cambia, la cadena existente deja de verificar.
AUDITORIA_CLAVE=
