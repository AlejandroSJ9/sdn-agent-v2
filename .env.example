DEDUP_SEGUNDOS=60
RATE_LIMIT_POR_MIN=60
DB_URL=sqlite:///./sdn_agent.db
# Clave secreta del HMAC de la auditoría (cadena larga y aleatoria). Si cambia, la cadena existente deja de verificar.
AUDITORIA_CLAVE=
